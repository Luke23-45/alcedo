{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "lib": ["ESNext", "DOM.AsyncIterable"],
    "module": "ESNext",
    "noUnusedParameters": false,
    "paths": {
      "@/*": ["./src/*"],
      "~/modules/*": ["./modules/*"],
      "@tolgee/web": ["./src/store/tolgee.d.ts"]
    },
    "noUncheckedIndexedAccess": true,
    "types": ["vitest", "node"],
    "exactOptionalPropertyTypes": false
  },
  "include": ["**/*.ts", "**/*.tsx", "types/*.d.ts", ".expo/types/**/*.ts", "expo-env.d.ts", "src/store/tolgee.d.ts"],
  "exclude": ["node_modules", "**/vitest/dist/**", "**/vitest/dist/chunks/**", "vitest.config.ts", "scripts/**"]
}
