{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "repsCompleted": {
      "type": "integer"
    },
    "completionDateTime": {
      "$ref": "./OffsetDateTime.json"
    },
    "type": {
      "type": "string",
      "enum": [
        "warmUp",
        "working",
        "failure",
        "drop"
      ]
    },
    "rpe": {
      "type": "number"
    }
  },
  "required": [
    "repsCompleted",
    "completionDateTime"
  ]
}