# Copy to .env and fill in. Every variable below is read by the backend;
# startup fails fast if a required one is missing (see src/config/env.validation.ts).

PORT=3000

# Persistence backend for this deployment: 'mongodb' or 'postgres'.
# Exactly one is active — never dual-write, never mixed.
DB_PROVIDER=mongodb

# MongoDB connection string (docker-compose provides mongodb://mongo:27017/alcedo locally).
# Required when DB_PROVIDER=mongodb.
MONGODB_URI=mongodb://localhost:27017/alcedo

# PostgreSQL connection string (docker-compose provides
# postgresql://alcedo:alcedo@localhost:5432/alcedo locally).
# Required when DB_PROVIDER=postgres. Schema via `npx prisma migrate deploy`.
#DATABASE_URL=postgresql://alcedo:alcedo@localhost:5432/alcedo

# Google OAuth — Web client ID used as the ID-token audience.
# The native app mints the ID token (Credential Manager on Android, Sign in with
# Google on iOS); the backend only verifies it.
GOOGLE_CLIENT_ID=
# Optional extra audiences, comma-separated (Android and iOS OAuth client IDs).
GOOGLE_EXTRA_AUDIENCES=

# Backend-issued access JWT (short-lived).
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# RevenueCat webhook: paste the secret from RevenueCat dashboard > Integrations > Webhooks.
REVENUECAT_WEBHOOK_SECRET=
# Entitlement identifier in RevenueCat that maps to premium.
REVENUECAT_PREMIUM_ENTITLEMENT=premium

# Website checkout webhook: shared HMAC-SHA256 secret with your web backend.
WEB_CHECKOUT_SECRET=change-me-to-a-long-random-secret

# LiteLLM self-hosted proxy (OpenAI-compatible). The backend calls the stable
# alias "coach-primary" — providers are switched in config/litellm.yaml.
LITELLM_URL=http://litellm:4000
LITELLM_API_KEY=
LITELLM_MODEL_ALIAS=coach-primary
# Upper bound for a single LiteLLM request (proxy + provider round trip), in ms.
LITELLM_TIMEOUT_MS=60000

# Daily AI message quotas (operator-tunable).
AI_FREE_DAILY_QUOTA=20
AI_PREMIUM_DAILY_QUOTA=200
# When true, AI streaming endpoints require premium; non-streaming stays quota-gated.
AI_STREAM_PREMIUM_ONLY=false

# Input moderation via the LiteLLM /moderations endpoint. Off by default.
MODERATION_ENABLED=false

# Coach skill injection budget: at most AI_MAX_SKILLS conditional skills and
# AI_MAX_SKILL_CHARS total characters injected into the prompt per turn.
AI_MAX_SKILLS=3
AI_MAX_SKILL_CHARS=6000

# Optional: Mem0 long-term memory. Unset = memory disabled (recall returns
# [], remember is a no-op); the chat itself is never affected.
MEM0_API_KEY=
# Base URL of the Mem0 service and the per-call timeout, in ms.
MEM0_URL=https://api.mem0.ai/v1
MEM0_TIMEOUT_MS=10000

# Global rate limiting.
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60

# Soft-deleted (tombstoned) records are hard-purged after this many days.
TOMBSTONE_RETENTION_DAYS=90

# Optional: comma-separated browser origins for CORS (native app needs none).
CORS_ORIGINS=
