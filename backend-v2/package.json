{
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.6.2"
  },
  "description": "Alcedo backend v2 — NestJS modular monolith (migration target for the .NET backend/)",
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/testing": "^11.1.6",
    "@prisma/client": "^7.10.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.19.0",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "license": "UNLICENSED",
  "name": "@alcedo/backend-v2",
  "private": true,
  "scripts": {
    "build": "nest build",
    "lint": "oxlint src",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "test:parity": "jest --config test/parity/jest.config.cjs"
  },
  "version": "0.1.0"
}
